        <mxCell id="7_E9tZItImS3vFxpnXMw-23" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="把 文本按连续 N 个自负切成一组片段&lt;div&gt;Jaccard 相似度 =&amp;nbsp;Jaccard 相似度 = |A ∩ B| / |A ∪ B| -交集 = 两段文本共有的 3-gram 数量 并集 = 两段文本所有 3-gram 的总数- 结果 ∈ [0, 1]&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="411" x="97" y="574.5" as="geometry" />
        </mxCell>
