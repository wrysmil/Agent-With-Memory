lass=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;skill&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;LLM 提取&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;LLM 返回，默认 0.7&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;去重&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;语义记忆&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;error&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;LLM 提取&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;LLM 返回，默认 0.7&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;去重&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;规则记忆&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;rule&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;正则提取&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;固定 0.7&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;去重&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;情节记忆&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Episode 表&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;LLM 提取&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;LLM 返回，默认 0.7&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;不去重&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;工作记忆&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;Scratchpad 表&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;覆盖/LLM&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;-&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;覆盖写入&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&