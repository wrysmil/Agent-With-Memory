ot;&gt;^...&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;span class=&quot;font-semibold&quot;&gt;开头&lt;/span&gt;必须是 &lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;/&lt;/code&gt; 或 please&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;_FOLLOW_UP_CJK/EN&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;^...&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;span class=&quot;font-semibold&quot;&gt;开头&lt;/span&gt;必须是追问词&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;_TASK_VERBS&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;无&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;span class=&quot;font-semibold&quot;&gt;任意位置&lt;/span&gt;出现即命中&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;_QUERY_MARKERS&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;无&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;span class=&quot;font-semibold&quot;&gt;任意位置&lt;/span&gt;出现即命中&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
