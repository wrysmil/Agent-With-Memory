-4 py-2 text-sm&quot;&gt;&lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;importance&lt;/font&gt;&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;重要性（0.5-1.0）&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;tags&lt;/font&gt;&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;标签列表&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
