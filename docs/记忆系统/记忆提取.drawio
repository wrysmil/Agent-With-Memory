        <mxCell id="7_E9tZItImS3vFxpnXMw-72" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;table class=&quot;w-full border-collapse border border-border&quot;&gt;&lt;thead class=&quot;bg-muted/80&quot;&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot;&gt;步骤&lt;/th&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot;&gt;做什么&lt;/th&gt;&lt;th class=&quot;whitespace-nowrap px-4 py-2 text-left font-semibold text-sm&quot;&gt;为什么&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody class=&quot;divide-y divide-border bg-muted/40&quot;&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;b&gt;扫描&lt;/b&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;找出所有 &lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;ActionNode&lt;/code&gt;（工具调用记录）&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;工具被用过 → 用户在做事的事实&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;b&gt;抽取&lt;/b&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;取 &lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;tool_name&lt;/code&gt; 作为结构化字段&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;不需要 LLM 就能知道&quot;用户用了哪些工具&quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;b&gt;脱敏&lt;/b&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;_REDACT_PATTERNS&lt;/code&gt; 替换 api_key/secret/token/bearer/aws_* 为 &lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;&amp;lt;redacted&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;span class=&quot;font-semibold&quot;&gt;FIX-3&lt;/span&gt;：阻止凭据外发到 LLM（虽然本阶段没调 LLM，但候选会传给阶段2）&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;b&gt;截断&lt;/b&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;input ≤ 512 字符、output ≤ 2048 字符&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;span class=&quot;font-semibold&quot;&gt;FIX-3&lt;/span&gt;：防巨型工具输出撑爆 prompt&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;b&gt;产出&lt;/b&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;system_candidates&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;留作阶段 3 过滤后写库&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
