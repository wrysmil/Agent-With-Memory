        <mxCell id="7_E9tZItImS3vFxpnXMw-22" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;background-color: rgb(255, 255, 255); color: rgb(8, 8, 8);&quot;&gt;&lt;pre style=&quot;font-family: Menlo-Regular, monospace;&quot;&gt;&lt;span style=&quot;font-size: 11px; background-color: rgb(237, 252, 237); color: rgb(6, 125, 23);&quot;&gt;&lt;div style=&quot;background-color: rgb(255, 255, 255); color: rgb(8, 8, 8);&quot;&gt;&lt;pre style=&quot;font-family: Menlo-Regular, monospace;&quot;&gt;&lt;font color=&quot;#067d17&quot;&gt;用户喜欢 X  和 用户不喜欢 X被&lt;br&gt;错误去重 &lt;/font&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/span&gt;&lt;/pre&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="52" width="175" x="380" y="500" as="geometry" />
