cus&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;❌&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;覆盖写入&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;span class=&quot;font-semibold&quot;&gt;T0&#39;&#39; 话题切换&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;before_iteration&lt;/code&gt; 话题NEW&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;update_focus&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;❌&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;覆盖写入，旧内容滚入 active_projects&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;border-border border-b&quot;&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;span class=&quot;font-semibold&quot;&gt;S1 Step3&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;会话结束&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;&lt;code class=&quot;rounded bg-muted px-1.5 py-0.5 font-mono text-sm&quot;&gt;format_with_llm&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;✅（默认关）&lt;/td&gt;&lt;td class=&quot;px-4 py-2 text-sm&quot;&gt;LLM 深度重构为 4 段 Markdown&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
